    "name": "Joel Arvidsson",
    "email": "joel@oblador.se"
  },
  "contributors": [
    "Dorian Mazur <mazur.dorian15@gmail.com> (https://github.com/DorianMazur)",
    "Vojtech Novak <vonovak@gmail.com> (https://github.com/vonovak)"
